PORT=4000
JWT_SECRET=your_jwt_secret_key_at_least_24_characters_long
POST_THRESHOLD=5
CLIENT_ORIGIN=http://localhost:5173

# Optional persistent storage paths (defaults to server/src/data/files and server/uploads)
# Set to /var/data if using a persistent disk volume on Render or Docker
DATA_DIR=
UPLOAD_DIR=

# Optional JSON seed to rehydrate ephemeral container databases across redeployments
DATA_JSON=
