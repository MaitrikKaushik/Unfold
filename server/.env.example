# Unfold API — local development configuration
# Copy this file to server/.env and replace the required values.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Required. Generate a strong local secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# Required. MongoDB Atlas or a local replica-set connection (transactions are used for post/vote writes).
MONGODB_URI=mongodb://127.0.0.1:27017/unfold?replicaSet=rs0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

# Optional during the authentication foundation. Leave blank unless PostgreSQL is running.
DATABASE_URL=
PG_POOL_MAX=5
PGSSLMODE=disable

# Optional during the authentication foundation. Leave blank unless Redis is running.
REDIS_URL=

# Required for image/audio upload routes. The API can start without these values, but uploads will return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Legacy compatibility data and local upload paths.
DATA_DIR=./src/data
UPLOAD_DIR=./uploads

LOG_LEVEL=debug

# Media upload limits for Cloudinary-backed post attachments
MAX_MEDIA_FILES=5
MAX_MEDIA_SIZE_MB=25
